{
  "name": "@ecom/contracts",
  "version": "1.6.0",
  "private": true,
  "description": "Versioned shared contracts for the e-commerce platform",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "VERSIONING.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "zod": ">=4 <5"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "zod": "^4.1.0"
  }
}
